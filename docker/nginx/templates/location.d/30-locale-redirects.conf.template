# Canonical English path.
location = /en {
  return 301 /;
}

location = /en/ {
  return 301 /;
}

# Canonical Turkish path with trailing slash.
location = /tr {
  return 301 /tr/;
}

# Unsupported 2-letter locale prefixes are redirected to English root.
location ~ ^/(?!en(?:/|$)|tr(?:/|$))[a-z][a-z]/?$ {
  return 301 /;
}
